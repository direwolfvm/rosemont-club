# Public Firebase client identifiers, returned by /api/config.
GOOGLE_CLOUD_PROJECT=permitting-ai-helper
FIRESTORE_DATABASE=rosemont-club
FIREBASE_TENANT_ID=alex311-qfnem
FIREBASE_API_KEY=use-the-public-value-from-deploy-env.yaml
FIREBASE_APP_ID=use-the-public-value-from-deploy-env.yaml
APP_BASE_URL=http://localhost:3107
# Optional comma-separated additional trusted origins.
APP_ADDITIONAL_ORIGINS=
# Private values: use Secret Manager in production. Never commit an actual key.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAIL_FROM=
MAILGUN_API_BASE_URL=https://api.mailgun.net
# Optional: base64 of 32 random bytes (openssl rand -base64 32). Enables the
# opt-in "remember my address" option. Without it, that option is disabled.
ADDRESS_KEY=
